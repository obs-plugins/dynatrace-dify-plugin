# Dify Plugin Remote Debugging
# Copy this file to .env and fill in your values

# Remote debugging key from your Dify workspace (Settings > Plugin > Debugging)
DIFY_PLUGIN_DEBUGGING_KEY=your-remote-debugging-key-here

# Host of your Dify instance (default: localhost for local dev)
DIFY_PLUGIN_DEBUGGING_HOST=localhost

# Port for the remote debugging connection
DIFY_PLUGIN_DEBUGGING_PORT=5003
